<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="483.0" prefWidth="413.0" spacing="25.0" style="-fx-background-color: linear-gradient(to bottom right, #1e1e2f, #2d2d44); -fx-background-radius: 15;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.micuriosidad.prueba.PrimaryController">
   <children>
      <!-- Icono simulado moderno -->
      <Label style="-fx-background-color: #6c5ce7; -fx-background-radius: 50; -fx-padding: 15 22 15 22;" text="🚀" textFill="WHITE">
         <font>
            <Font size="32.0" />
         </font>
         <effect>
            <!-- Corregido: Color directo en formato Hexadecimal con transparencia -->
            <DropShadow blurType="GAUSSIAN" color="#6c5ce780" radius="15.0" width="31.0" />
         </effect>
      </Label>
      
      <!-- Título Estilizado -->
      <Label text="¡Bienvenido a JavaFX!" textFill="WHITE">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      
      <!-- Subtítulo Informativo -->
      <Label text="Adiós a las ventanas grises y aburridas de Swing. Esto es el futuro del diseño en escritorio." textAlignment="CENTER" textFill="#a0a0b8" wrapText="true">
         <font>
            <Font size="14.0" />
         </font>
         <VBox.margin>
            <Insets left="20.0" right="20.0" />
         </VBox.margin>
      </Label>
      
      <!-- Botón con Estilo CSS Moderno -->
      <Button mnemonicParsing="false" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: linear-gradient(to right, #00cec9, #0984e3); -fx-background-radius: 25; -fx-cursor: hand;" text="Explorar Interfaz" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
         <effect>
            <!-- Corregido: Color directo en formato Hexadecimal con transparencia -->
            <DropShadow color="#0984e366" height="10.0" radius="4.5" width="10.0" />
         </effect>
      </Button>
      <Button mnemonicParsing="false" onAction="#mostrarHolaMundo" style="-fx-background-color: linear-gradient(to right, #00cec9, #0984e3);" text="HOLA" textFill="WHITE" />
   </children>
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
</VBox>
